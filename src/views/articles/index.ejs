<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="container">
      <h1>Articles</h1>
      <p class="subtitle">EJS template</p>
    </header>

    <main class="container">
      <ul class="list">
        <% articles.forEach(a => { %>
          <li class="card">
            <div>
              <strong><%= a.title %></strong>
              <span class="meta">by <%= a.author %></span>
            </div>
            <a class="button" href="/articles/<%= a.id %>">Read</a>
          </li>
        <% }) %>
      </ul>
    </main>

    <footer class="container footer">
      <a class="link" href="/">Back to root</a>
    </footer>
  </body>
</html>