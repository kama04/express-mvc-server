doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet" href="/styles.css")
  body
    header.container
      h1 User Details
      p.subtitle PUG template

    main.container
      .card
        p
          strong ID:
          |  #{user.id}
        p
          strong Username:
          |  #{user.username}
        p
          strong Role:
          |  #{user.role}

      a.button(href="/users") ← Back to users

    footer.container.footer
      a.link(href="/") Back to root