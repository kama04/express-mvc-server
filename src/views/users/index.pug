doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet" href="/styles.css")
  body
    header.container
      h1 Users
      p.subtitle PUG template

    main.container
      ul.list
        each u in users
          li.card
            div
              strong= u.username
              span.badge= u.role
            a.button(href=`/users/${u.id}`) View

    footer.container.footer
      a.link(href="/") Back to root